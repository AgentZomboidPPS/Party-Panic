-- Struggle (Versus, 75s): TODO describe the game in one line.
--
-- Generated by `lune run tools/new-minigame`. It already works: players spawn on a platform in a
-- meadow, earn a point every second they stay on it, and can press CHEER (see the client half in
-- src/client/MiniGames/Struggle.luau). Replace the arena and rules with your own.
--
-- The server owns the rules: clients only ask (ctx:OnAction) and draw what it shares
-- (ctx:SetShared / SetSharedJSON). Check positions by distance, never with Touched.
-- Handy context methods (see Services/RoundContext.luau for all of them):
--   ctx:SpawnAll(points, frozen)   ctx:GetAlivePlayers()   ctx:Eliminate(player, reason)
--   ctx:AddScore(player, n)        ctx:SetScoreText(p, t)  ctx:SetStatus(text)  ctx:Announce(text)
--   ctx:Loop(fn)  ctx:Heartbeat(fn)  ctx:Delay(t, fn)  -- all stop by themselves when the round ends
--   ctx:OnAction(name, fn)  ctx:SetShared(key, v)  ctx:Fire(target, name, ...)  ctx:ShareTemplate(name, model)
--   ctx:SetTeam(player, "Red")  ctx:AddTeamScore("Red", n)  ctx.Hooks.Respawn / Eliminated / PlayerLeft
-- Building blocks: Kit/Scenery (meadow, lava lake, volcanoes), Kit/ArenaKit (spawns, warnings),
-- World/Shapes (rounded geometry), World/MeshLibrary (mesh props; yours go in World/Props/Struggle.luau).

local ArenaKit = require(script.Parent.Kit.ArenaKit)
local MiniGame = require(script.Parent.Kit.MiniGame)
local Scenery = require(script.Parent.Kit.Scenery)
local MeshLibrary = require(script.Parent.Parent.World.MeshLibrary)
local Shapes = require(script.Parent.Parent.World.Shapes)

local Struggle = MiniGame.Define("Struggle", { Results = "Team" })

function Struggle:Prepare()
	local ctx = self.context
	ctx.RespawnMode = "Respawn" -- "Eliminate": falling knocks you out. "Respawn": you come back.
	ctx.EndWhenOneLeft = false
	ctx.KillY = ctx.Origin.Y - 30
	local origin = ctx.Origin.Position

	-- 1. Build the arena under ctx.Arena (it's removed automatically after the round).
	Scenery.Meadow(ctx, origin - Vector3.new(0, 6, 0), 300)
	Shapes.Slab(Vector3.new(80, 4, 80), 10, {
		Name = "Floor",
		CFrame = ArenaKit.At(ctx, Vector3.new(0, -2, 0)),
		Color = ArenaKit.Colors.Floor,
		Parent = ctx.Arena,
	})
	MeshLibrary.Get("StruggleTrophy", { CFrame = ArenaKit.At(ctx, Vector3.new(0, 0, -30)), Parent = ctx.Arena })

	-- 2. Place everyone, frozen until the countdown finishes.
	ctx:SpawnAll(ArenaKit.SpawnRing(origin, 14, #ctx:GetPlayers()), true)
	ctx:SetStatus("Get ready!")
end

function Struggle:Start()
	local ctx = self.context
	-- 3. Controls the client half sends (validate everything: it comes from the player's device).
	ctx:OnAction("Cheer", function(player)
		local _, _, root = ctx:GetCharacter(player)
		if root then
			ctx:Fire(nil, "Cheered", player.UserId)
		end
	end, { Interval = 1 })

	-- 4. Run the game. Return the seconds to wait from a Loop step, or nil to stop it.
	ctx:Loop(function()
		local best, bestScore = nil, -1
		for _, player in ctx:GetAlivePlayers() do
			ctx:AddScore(player, 1)
			local state = ctx:State(player)
			if state and state.Score > bestScore then
				best, bestScore = player, state.Score
			end
		end
		ctx:SetShared("Lead", if best then best.DisplayName else "")
		ctx:SetStatus(`Players left: {ctx:AliveCount()}`)
		return 1
	end)
end

-- Optional: override :Stop(reason), :GetResults() or :Cleanup() - see Kit/MiniGame.luau.

return Struggle
