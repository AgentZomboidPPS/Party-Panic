-- Client half of Snowball Summit: draws what the server shares and sends the player's controls.
--
-- Generated by `lune run tools/new-minigame`. The server half shares the round's state with
-- ctx:SetShared/SetSharedJSON ("Lead" here) and listens for api:Action calls with ctx:OnAction.
-- Everything made through api (World, Gui, Button, RenderStep, Track) is cleaned up after the round.
--
--   api:TopHud() / api:HudY()  your HUD goes here, under the round banner, on every screen size
--   api:Button({ Text, Key })  a big action button (beside the jump button on phones)
--   api:Template(name)         a copy of a model the server shared with ctx:ShareTemplate
--   api:Sound(name) / Effect   local feedback; api:Mood({...}) tints the arena for this player
--   api:CharacterOf(userId)    anyone's character, bots included; api:Participants() lists the round

local Theme = require(script.Parent.Parent.UI.Theme)
local UIKit = require(script.Parent.Parent.UI.UIKit)

local SnowballSummit = {}

function SnowballSummit.Start(api)
	local label = UIKit.Label({
		Name = "Lead",
		Text = "",
		Font = Theme.Fonts.Display,
		TextSize = 34,
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, api:HudY()),
		Size = UDim2.fromOffset(420, 46),
		Parent = api:TopHud(),
		Children = { UIKit.TextStroke(0.15) },
	})
	local function refresh()
		local lead = api:Shared("Lead")
		label.Text = if lead and lead ~= "" then `👑 {lead}` else ""
	end
	api:OnShared("Lead", refresh)
	refresh()

	local cheer = api:Button({ Text = "CHEER", Key = Enum.KeyCode.E, Color = Theme.Colors.Yellow })
	cheer.Pressed:Connect(function()
		api:Action("Cheer")
		api:Sound("Boing")
	end)
end

return SnowballSummit
