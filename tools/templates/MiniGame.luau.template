-- {{Name}} ({{Category}}, {{Duration}}s): TODO describe the game in one line.
--
-- Generated by `lune run tools/new-minigame`. It already works: players spawn on a floating
-- platform and earn a point every second they stay on it. Replace the arena and rules with your
-- own. Test it in Studio by setting Config.Debug.ForceGame = "{{Id}}" (Shared/Config.luau).
--
-- Handy context methods (see Services/RoundContext.luau for all of them):
--   ctx:SpawnAll(points, frozen)   ctx:GetAlivePlayers()   ctx:Eliminate(player, reason)
--   ctx:AddScore(player, n)        ctx:SetScoreText(p, t)  ctx:SetStatus(text)  ctx:Announce(text)
--   ctx:Loop(fn)  ctx:Heartbeat(fn)  ctx:Delay(t, fn)  -- all stop by themselves when the round ends
--   ctx:SetTeam(player, "Red")  ctx:AddTeamScore("Red", n)  ctx.Hooks.Respawn / Eliminated / PlayerLeft
-- Building blocks: Kit/ArenaKit (spawns, warnings, signs), World/Shapes (rounded geometry),
-- World/MeshLibrary (mesh props), Kit/Glove (melee tool).

local ArenaKit = require(script.Parent.Kit.ArenaKit)
local MiniGame = require(script.Parent.Kit.MiniGame)
local Shapes = require(script.Parent.Parent.World.Shapes)

local {{Id}} = MiniGame.Define("{{Id}}", { Results = "{{Results}}" })

function {{Id}}:Prepare()
	local ctx = self.context
	ctx.RespawnMode = "{{RespawnMode}}" -- "Eliminate": falling knocks you out. "Respawn": you come back.
	ctx.EndWhenOneLeft = {{EndWhenOneLeft}}
	ctx.KillY = ctx.Origin.Y - 30

	-- 1. Build the arena under ctx.Arena (it's removed automatically after the round).
	Shapes.Slab(Vector3.new(80, 4, 80), 10, {
		Name = "Floor",
		CFrame = ArenaKit.At(ctx, Vector3.new(0, -2, 0)),
		Color = ArenaKit.Colors.Floor,
		Parent = ctx.Arena,
	})

	-- 2. Place everyone, frozen until the countdown finishes.
	ctx:SpawnAll(ArenaKit.SpawnRing(ctx.Origin.Position, 14, #ctx:GetPlayers()), true)
	ctx:SetStatus("Get ready!")
end

function {{Id}}:Start()
	local ctx = self.context
	-- 3. Run the game. Return the seconds to wait from a Loop step, or nil to stop it.
	ctx:Loop(function()
		for _, player in ctx:GetAlivePlayers() do
			ctx:AddScore(player, 1)
		end
		ctx:SetStatus(`Players left: {ctx:AliveCount()}`)
		return 1
	end)
end

-- Optional: override :Stop(reason), :GetResults() or :Cleanup() - see Kit/MiniGame.luau.

return {{Id}}
